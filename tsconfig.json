{
  "extends": "./packages/config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "incremental": false
  },
  "include": [
    "scripts",
    "docker/**/*.test.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "eslint.boundaries.js",
    "packages/config/*.js"
  ],
  "exclude": ["node_modules", "**/node_modules", "**/dist"]
}
