{
  "extends": "@flowaid/config/tsconfig.react.json",
  "compilerOptions": {
    "jsx": "preserve",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@/*": ["../../packages/ui/src/*"],
      "@flowaid/workflow-core": ["../../packages/workflow-core/dist/index.d.ts"],
      "@flowaid/workflow-compiler": ["../../packages/workflow-compiler/dist/index.d.ts"],
      "@flowaid/shared": ["../../packages/shared/dist/index.d.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "../../packages/ui/src/primitives/css-vars.d.ts",
    "app",
    "app/.well-known/**/*",
    "src",
    ".next/types/**/*.ts",
    "next.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
