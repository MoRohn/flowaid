{
  "name": "@flowaid/evaluation",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluation for flowaid workflows: typed expectations, a bounded-concurrency runner over an injected run launcher, scorers per matcher (incl. an LLM/TypeSafe judge), calibration (ECE), comparison and regression reports (ARCHITECTURE.md §10.4).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@flowaid/providers": "workspace:*",
    "@flowaid/shared": "workspace:*",
    "@flowaid/workflow-core": "workspace:*",
    "ajv": "8.20.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@flowaid/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
