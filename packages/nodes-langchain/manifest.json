    {
      "capabilities": [
        "generation",
        "credentials",
        "network",
        "state"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {
          "collection": {
            "default": "knowledge",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$",
            "type": "string",
            "x-ui": {
              "help": "Collection (Qdrant), namespace (Pinecone) or workspace collection."
            }
          },
          "embeddingModel": {
            "properties": {
              "model": {
                "minLength": 1,
                "type": "string"
              },
              "provider": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "provider",
              "model"
            ],
            "type": "object",
            "x-ui": {
              "widget": "model"
            }
          },
          "fetchK": {
            "default": 20,
            "maximum": 200,
            "minimum": 1,
            "type": "integer"
          },
          "k": {
            "default": 4,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "lambda": {
            "default": 0.5,
            "maximum": 1,
            "minimum": 0,
            "type": "number",
            "x-ui": {
              "help": "1 = relevance only, 0 = diversity only.",
              "showWhen": {
                "equals": "mmr",
                "path": "/strategy"
              }
            }
          },
          "model": {
            "properties": {
              "model": {
                "minLength": 1,
                "type": "string"
