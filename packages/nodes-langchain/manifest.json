{
  "nodes": [
    {
      "capabilities": [
        "generation",
        "credentials",
        "tools",
        "suspend"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {
          "maxCostUsd": {
            "minimum": 0,
            "type": "number"
          },
          "maxOutputTokens": {
            "default": 2048,
            "maximum": 65536,
            "minimum": 1,
            "type": "integer"
          },
          "maxSteps": {
            "default": 8,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "maxTokens": {
            "minimum": 1,
            "type": "integer"
          },
          "maxToolCalls": {
            "default": 16,
            "maximum": 200,
            "minimum": 0,
            "type": "integer"
          },
          "model": {
            "properties": {
              "model": {
                "minLength": 1,
                "type": "string"
              },
              "provider": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "provider",
              "model"
            ],
            "type": "object",
            "x-ui": {
              "widget": "model"
            }
          },
          "system": {
            "default": "You are a careful assistant. Use the tools when they help; answer concisely.",
            "maxLength": 32000,
            "type": "string",
            "x-ui": {
              "widget": "textarea"
            }
          },
          "temperature": {
            "default": 0.2,
            "maximum": 2,
            "minimum": 0,
            "type": "number"
          },
          "tools": {
            "default": [],
            "items": {
              "properties": {
                "approval": {
                  "default": "tool_default",
                  "enum": [
                    "never",
                    "always",
                    "tool_default"
                  ],
                  "type": "string"
                },
                "name": {
                  "pattern": "^[A-Za-z0-9_-]{1,64}$",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "maxItems": 32,
            "type": "array",
            "x-ui": {
              "help": "Workflow tools the agent may call, with their approval policy.",
              "widget": "list"
            }
          }
        },
        "required": [
          "model"
        ],
        "type": "object"
      },
      "controlPorts": [],
      "credentials": [
        {
          "description": "Credential of the chat or embedding model (native or langchain:<vendor>).",
          "name": "llm",
          "required": true,
          "types": [
            "openai.api_key",
            "anthropic.api_key",
            "ollama.host",
            "ollama.none"
          ]
        }
      ],
      "defaultPolicy": {
        "timeoutMs": 600000
      },
      "generation": true,
      "id": "@flowaid/nodes-langchain.agent",
      "idempotency": "none",
      "inputs": [
        {
          "name": "task",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        },
        {
          "name": "context",
          "required": false,
          "schema": {}
        }
      ],
      "metadata": {
        "category": "agent",
        "description": "A LangGraph ReAct agent over the workflow's tools, bounded by steps, tool calls, tokens, cost and time; tool calls that need approval pause the run for a person.",
        "icon": "bot",
        "name": "LangChain agent",
        "summary": "{{ config.model.model }} · {{ config.maxSteps }} steps",
        "tags": [
          "langchain",
          "langgraph",
          "agent",
          "react",
          "tools"
        ]
      },
      "migrations": [],
      "optionProviders": [],
      "outputs": [
        {
          "name": "answer",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "steps",
          "required": true,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        },
        {
          "name": "tool_calls",
          "required": true,
          "schema": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "args": {},
                "name": {
                  "type": "string"
                },
                "ok": {
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "args",
                "ok"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        {
          "name": "usage",
          "required": true,
          "schema": {
            "additionalProperties": false,
            "properties": {
              "inputTokens": {
                "minimum": 0,
                "type": "integer"
              },
              "outputTokens": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "inputTokens",
              "outputTokens"
            ],
            "type": "object"
          }
        }
      ],
      "pool": "general",
      "portRules": [],
      "streams": false,
      "version": "1.0.0"
    },
    {
      "capabilities": [
        "generation",
        "credentials",
        "streaming",
        "tools"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {
          "includeHistory": {
            "default": false,
            "type": "boolean",
            "x-ui": {
              "help": "Insert the `history` input before the last message.",
              "widget": "switch"
            }
          },
          "maxOutputTokens": {
            "default": 1024,
            "maximum": 65536,
            "minimum": 1,
            "type": "integer"
          },
          "messages": {
            "default": [
              {
                "content": "{input}",
                "role": "human"
              }
            ],
            "items": {
              "properties": {
                "content": {
                  "maxLength": 32000,
                  "minLength": 1,
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "system",
                    "human",
                    "ai"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "role",
                "content"
              ],
              "type": "object"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array",
            "x-ui": {
              "help": "Prompt template messages; {name} placeholders are filled from the `variables` input ({{ and }} escape braces).",
              "widget": "list"
            }
          },
          "model": {
            "properties": {
              "model": {
                "minLength": 1,
                "type": "string"
              },
              "provider": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "provider",
              "model"
            ],
            "type": "object",
            "x-ui": {
              "widget": "model"
            }
          },
          "outputSchema": {
            "type": "object",
            "x-ui": {
              "help": "JSON Schema for structured output (types `structured`).",
              "widget": "schema"
            }
          },
          "stream": {
            "default": true,
            "type": "boolean"
          },
          "temperature": {
            "default": 0.7,
            "maximum": 2,
            "minimum": 0,
            "type": "number"
          },
          "tools": {
            "default": [],
            "items": {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            "maxItems": 64,
            "type": "array",
            "x-ui": {
              "help": "Workflow tools the model may request (returned as tool_calls).",
              "widget": "list"
            }
          }
        },
        "required": [
          "model"
        ],
        "type": "object"
      },
      "controlPorts": [],
      "credentials": [
        {
          "description": "Credential of the chat or embedding model (native or langchain:<vendor>).",
          "name": "llm",
          "required": true,
          "types": [
            "openai.api_key",
            "anthropic.api_key",
            "ollama.host",
            "ollama.none"
          ]
        }
      ],
      "defaultPolicy": {
        "timeoutMs": 120000
      },
      "generation": true,
      "id": "@flowaid/nodes-langchain.chat",
      "idempotency": "safe",
      "inputs": [
        {
          "name": "variables",
          "required": false,
          "schema": {
            "default": {},
            "type": "object"
          }
        },
        {
          "name": "history",
          "required": false,
          "schema": {
            "items": {
              "properties": {
                "content": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "system",
                    "user",
                    "assistant",
                    "tool"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "role",
                "content"
              ],
              "type": "object"
            },
            "type": "array"
          }
        }
      ],
      "metadata": {
        "category": "generation",
        "description": "Runs a chat model with a LangChain prompt template ({variable} placeholders from `variables`, optional chat history). Streams text, returns structured output with an output schema, and returns tool calls when tools are offered.",
        "icon": "messages-square",
        "name": "LangChain chat",
        "summary": "{{ config.model.provider }}/{{ config.model.model }}",
        "tags": [
          "langchain",
          "llm",
          "prompt",
          "chat"
        ]
      },
      "migrations": [],
      "optionProviders": [],
      "outputs": [
        {
          "name": "text",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "structured",
          "required": true,
          "schema": {}
        },
        {
          "name": "tool_calls",
          "required": true,
          "schema": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "args": {},
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "args"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        {
          "name": "finish_reason",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "usage",
          "required": true,
          "schema": {
            "properties": {
              "inputTokens": {
                "minimum": 0,
                "type": "integer"
              },
              "outputTokens": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "inputTokens",
              "outputTokens"
            ],
            "type": "object"
          }
        }
      ],
      "pool": "general",
      "portRules": [
        {
          "kind": "outputSchemaFromConfig",
          "path": "/outputSchema",
          "port": "structured"
        }
      ],
      "streams": true,
      "version": "1.0.0"
    },
    {
      "capabilities": [
        "network",
        "credentials"
      ],
      "configSchema": {
        "additionalProperties": false,
        "properties": {
          "csvDelimiter": {
            "default": ",",
            "maxLength": 1,
            "minLength": 1,
            "type": "string"
          },
          "extensions": {
            "default": [
              ".md",
              ".mdx",
              ".txt"
            ],
            "items": {
              "maxLength": 20,
              "type": "string"
            },
            "maxItems": 50,
            "type": "array"
          },
          "include": {
            "maxLength": 2000,
            "type": "string",
            "x-ui": {
              "help": "Only pages whose URL starts with this.",
              "showWhen": {
                "equals": "sitemap",
                "path": "/source"
              }
            }
          },
          "jsonPointer": {
            "default": "",
            "pattern": "^(\\/.*)?$",
            "type": "string",
            "x-ui": {
              "help": "Pointer to the array (or value) to load.",
              "showWhen": {
                "equals": "json",
                "path": "/source"
              }
            }
          },
          "maxBytes": {
            "default": 2097152,
            "maximum": 20971520,
            "minimum": 1024,
            "type": "integer"
          },
          "maxPages": {
            "default": 50,
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "default": "",
            "maxLength": 1000,
            "type": "string"
          },
          "ref": {
            "default": "main",
            "maxLength": 200,
            "type": "string"
          },
          "repo": {
            "pattern": "^[\\w.-]+\\/[\\w.-]+$",
            "type": "string",
            "x-ui": {
              "placeholder": "owner/name",
              "showWhen": {
                "equals": "github",
                "path": "/source"
              }
            }
          },
          "source": {
            "default": "text",
            "enum": [
              "text",
              "markdown",
              "json",
              "jsonl",
              "csv",
              "html",
              "url",
              "sitemap",
              "github"
            ],
            "type": "string",
            "x-ui": {
              "widget": "select"
            }
          },
          "sourceName": {
            "default": "input",
            "maxLength": 500,
            "type": "string",
            "x-ui": {
              "help": "`metadata.source` for inline content."
            }
          },
          "textField": {
            "maxLength": 200,
            "type": "string",
            "x-ui": {
              "help": "JSON pointer (json/jsonl) or column (csv) holding the text; default the whole item."
            }
          }
        },
        "type": "object"
      },
      "controlPorts": [],
      "credentials": [
        {
          "description": "Token for private repositories and higher GitHub rate limits.",
          "name": "github",
          "required": false,
          "types": [
            "github.token"
          ]
        }
      ],
      "defaultPolicy": {
        "timeoutMs": 120000
      },
      "generation": false,
      "id": "@flowaid/nodes-langchain.document_loader",
      "idempotency": "safe",
      "inputs": [
        {
          "name": "content",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "urls",
          "required": false,
          "schema": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          }
        },
        {
          "name": "metadata",
          "required": false,
          "schema": {
            "default": {},
            "type": "object"
          }
        }
      ],
      "metadata": {
        "category": "retrieval",
        "description": "Loads documents from text, Markdown, JSON, JSON Lines, CSV or HTML content, or from web pages, a sitemap or a GitHub repository.",
        "icon": "file-text",
        "name": "Document loader",
        "summary": "{{ config.source }}",
        "tags": [
          "langchain",
          "rag",
          "loader",
          "documents"
