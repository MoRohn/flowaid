            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object"
                },
                "pageContent": {
                  "type": "string"
                }
              },
              "required": [
                "pageContent",
                "metadata"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        {
          "name": "count",
          "required": true,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "pool": "general",
      "portRules": [],
      "streams": false,
      "version": "1.0.0"
