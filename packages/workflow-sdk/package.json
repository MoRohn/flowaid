{
  "name": "@flowaid/workflow-sdk",
  "version": "0.9.0",
  "private": true,
  "description": "The FlowAId TypeScript SDK: the typed Flowaid client (types generated from the API's OpenAPI document), run handles with a resumable SSE transport, and the total workflow builders (API.md §8). Isomorphic: Node 24 and browsers.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./builders": {
      "types": "./src/builders/index.ts",
      "development": "./src/builders/index.ts",
      "default": "./dist/builders/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "src",
    "dist",
    "openapi.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@flowaid/shared": "workspace:*",
    "@flowaid/workflow-core": "workspace:*",
    "eventsource-parser": "4.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@flowaid/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
