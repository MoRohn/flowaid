{
  "name": "@flowaid/openapi-tools",
  "version": "0.9.1",
  "private": true,
  "description": "OpenAPI 3.0/3.1 import for flowaid: SSRF-safe parsing with bounded external refs, one tool per operation, argument coercion and request execution with auth and Idempotency-Key (ARCHITECTURE.md §10.3).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@flowaid/shared": "workspace:*",
    "@flowaid/workflow-core": "workspace:*",
    "@readme/openapi-parser": "9.0.0",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@flowaid/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
