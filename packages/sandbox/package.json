{
  "name": "@flowaid/sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Sandboxed code execution for the flowaid code pool: isolated-vm isolates with memory, CPU and wall-clock limits and scoped bridges, and a container executor (no network, read-only, bounded) for code and shell (ARCHITECTURE.md §10.7, RFC-0019).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@flowaid/shared": "workspace:*",
    "@flowaid/workflow-core": "workspace:*",
    "ajv": "8.20.0",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@flowaid/config": "workspace:*",
    "@types/node": "26.6.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "isolated-vm": "7.0.1"
  }
}
