{
  "name": "@flowaid/provider-anthropic",
  "version": "0.1.0",
  "private": true,
  "description": "Anthropic Claude generation provider for flowaid: the Messages API with streaming (text, thinking, tool input), tools, structured output through a forced respond tool, prompt caching and cache-token accounting (ARCHITECTURE.md \u00a76.6).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@flowaid/providers": "workspace:*",
    "@flowaid/shared": "workspace:*",
    "@flowaid/workflow-core": "workspace:*",
    "eventsource-parser": "4.1.1"
  },
  "devDependencies": {
    "@flowaid/config": "workspace:*",
    "@types/node": "26.6.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
