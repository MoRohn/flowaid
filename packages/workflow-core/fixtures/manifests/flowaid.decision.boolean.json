{
  "id": "flowaid.decision.boolean",
  "version": "1.0.0",
  "metadata": {
    "name": "Boolean",
    "description": "Answers a yes/no question about `state` with `pYes` and `confidence = max(pYes, 1 - pYes)` (TypeSafe boolean decision).",
    "category": "decision",
    "icon": "toggle-left",
    "tags": ["decision", "typesafe"],
    "summary": "{{ config.instructions }}"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "instructions": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000,
        "x-ui": {
          "widget": "textarea"
        }
      },
      "criteria": {
        "type": "object",
        "properties": {
          "true": {
            "type": "string"
          },
          "false": {
            "type": "string"
          }
        },
        "required": ["true", "false"],
        "additionalProperties": false,
        "x-ui": {
          "widget": "criteria",
          "help": "Optional descriptions of what makes the answer true or false (both or none)."
        }
      }
    },
    "required": ["instructions"],
    "additionalProperties": false
  },
  "inputs": [
    {
      "name": "state",
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ],
        "description": "TypeSafe state: text, an object (sent verbatim) or an array of text."
      },
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "decision",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "__schema0": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                },
                "propertyNames": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "type": "object",
        "properties": {
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "usage": {
            "type": "object",
            "properties": {
              "inputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cacheReadTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "cacheWriteTokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["inputTokens", "outputTokens"],
            "additionalProperties": false
          },
          "costUsd": {
            "type": "number",
            "minimum": 0
          },
          "requestId": {
            "type": "string"
          },
          "raw": {
            "$ref": "#/$defs/__schema0"
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "outcome": {
                  "type": "string",
                  "enum": ["ok", "error", "skipped_unhealthy"]
                },
                "errorCode": {
                  "type": "string",
                  "enum": [
                    "WORKFLOW_VALIDATION_ERROR",
                    "SCHEMA_VALIDATION_ERROR",
                    "NODE_EXECUTION_ERROR",
                    "TOOL_EXECUTION_ERROR",
                    "PROVIDER_ERROR",
                    "PROVIDER_RATE_LIMITED",
                    "PROVIDER_OVERLOADED",
                    "CREDENTIAL_ERROR",
                    "TIMEOUT_ERROR",
                    "RATE_LIMIT_ERROR",
                    "CANCELLED_ERROR",
                    "BOUNDS_EXCEEDED",
                    "INPUT_MISSING",
                    "OUTPUT_SCHEMA_MISMATCH",
                    "EXPRESSION_ERROR",
                    "SANDBOX_ERROR",
                    "WORKER_LOST",
                    "NONIDEMPOTENT_INTERRUPTED",
                    "HUMAN_APPROVAL_REQUIRED",
                    "HUMAN_TASK_EXPIRED",
                    "SUBFLOW_ERROR",
                    "NO_OUTPUT",
                    "NETWORK_ERROR",
                    "NOT_FOUND",
                    "CONFLICT",
                    "UNAUTHORIZED",
                    "FORBIDDEN",
                    "BAD_REQUEST",
                    "PAYLOAD_TOO_LARGE",
                    "INTERNAL"
                  ]
                },
                "latencyMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["provider", "model", "outcome", "latencyMs"],
              "additionalProperties": false
            }
          },
          "kind": {
            "type": "string",
            "const": "boolean"
          },
          "value": {
            "type": "boolean"
          },
          "pYes": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "probabilities": {
            "type": "object",
            "properties": {
              "true": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "false": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": ["true", "false"],
            "additionalProperties": false
          }
        },
        "required": [
          "confidence",
          "provider",
          "model",
          "latencyMs",
          "costUsd",
          "attempts",
          "kind",
          "value",
          "pYes",
          "probabilities"
        ],
        "additionalProperties": false
      },
      "required": true
    }
  ],
  "controlPorts": [],
  "portRules": [],
  "credentials": [
    {
      "name": "typesafe",
      "types": ["typesafe.api_key"],
      "required": true
    }
  ],
  "capabilities": ["decision", "credentials"],
  "idempotency": "safe",
  "pool": "general",
  "decision": {
    "kind": "boolean"
  },
  "generation": false,
  "streams": false,
  "optionProviders": [],
  "migrations": [],
  "defaultPolicy": {
    "timeoutMs": 30000
  }
}
