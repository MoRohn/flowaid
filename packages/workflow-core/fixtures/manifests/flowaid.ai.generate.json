{
  "id": "flowaid.ai.generate",
  "version": "1.0.0",
  "metadata": {
    "name": "Generate text",
    "description": "Generates text from a prompt with a chat model; streams deltas when `stream` is on.",
    "category": "generation",
    "icon": "sparkles",
    "tags": ["llm", "generation"],
    "summary": "{{ config.model.provider }}/{{ config.model.model }}"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "model": {
        "anyOf": [
          {
            "properties": {
              "model": {
                "minLength": 1,
                "type": "string"
              },
              "provider": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["provider", "model"],
            "type": "object"
          },
          {
            "properties": {
              "candidates": {
                "items": {
                  "properties": {
                    "model": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "provider": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": ["provider", "model"],
                  "type": "object"
                },
                "maxItems": 5,
                "minItems": 1,
                "type": "array"
              },
              "maxCostUsdPerCall": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "requirements": {
                "properties": {
                  "jsonSchema": {
                    "type": "boolean"
                  },
                  "minContext": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "tools": {
                    "type": "boolean"
                  },
                  "vision": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              "strategy": {
                "default": "ordered",
                "enum": ["ordered", "cheapest", "fastest", "healthiest"],
                "type": "string"
              }
            },
            "required": ["candidates"],
            "type": "object"
          }
        ],
        "x-ui": {
          "widget": "model"
        }
      },
      "system": {
        "type": "string",
        "maxLength": 32000,
        "x-ui": {
          "widget": "template"
        }
      },
      "temperature": {
        "type": "number",
        "minimum": 0,
        "maximum": 2,
        "default": 1
      },
      "maxOutputTokens": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65536,
        "default": 1024
      },
      "stream": {
        "type": "boolean",
        "default": true
      }
    },
    "required": ["model"],
    "additionalProperties": false
  },
  "inputs": [
    {
      "name": "prompt",
      "schema": {
        "type": "string"
      },
      "required": false
    },
    {
      "name": "messages",
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": ["system", "user", "assistant", "tool"]
            },
            "content": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "text"
                          },
                          "text": {
                            "type": "string"
                          }
                        },
                        "required": ["type", "text"]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "const": "image"
                          },
                          "mimeType": {
                            "type": "string"
                          },
                          "data": {
                            "type": "string"
                          }
                        },
                        "required": ["type", "mimeType", "data"]
                      }
                    ]
                  }
                }
              ]
            },
            "toolCallId": {
              "type": "string"
            }
          },
          "required": ["role", "content"]
        }
      },
      "required": false
    }
  ],
  "outputs": [
    {
      "name": "text",
      "schema": {
        "type": "string"
      },
      "required": true
    },
    {
      "name": "finish_reason",
      "schema": {
        "type": "string"
      },
      "required": true
    },
    {
      "name": "usage",
      "schema": {
        "type": "object",
        "properties": {
          "inputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["inputTokens", "outputTokens"]
      },
      "required": true
    }
  ],
  "controlPorts": [],
  "portRules": [],
  "credentials": [
    {
      "name": "llm",
      "types": ["openai.api_key", "anthropic.api_key", "ollama.none"],
      "required": true
    }
  ],
  "capabilities": ["generation", "credentials", "streaming"],
  "idempotency": "safe",
  "pool": "general",
  "generation": true,
  "streams": true,
  "optionProviders": ["models"],
  "migrations": [],
  "defaultPolicy": {
    "timeoutMs": 120000
  }
}
