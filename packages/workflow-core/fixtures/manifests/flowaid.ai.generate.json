{
  "id": "flowaid.ai.generate",
  "version": "1.0.0",
  "metadata": {
    "name": "Generate text",
    "description": "Generates text from a prompt with a chat model; streams deltas when `stream` is on.",
    "category": "generation",
    "icon": "sparkles",
    "tags": ["llm", "generation"],
    "summary": "{{ config.model.provider }}/{{ config.model.model }}"
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "model": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["provider", "model"],
        "x-ui": {
          "widget": "model"
        }
      },
      "system": {
        "type": "string",
        "maxLength": 32000,
        "x-ui": {
          "widget": "template"
        }
      },
      "temperature": {
        "type": "number",
        "minimum": 0,
        "maximum": 2,
        "default": 1
      },
      "maxOutputTokens": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65536,
        "default": 1024
      },
      "stream": {
        "type": "boolean",
        "default": true
      }
    },
    "required": ["model"],
    "additionalProperties": false
  },
  "inputs": [
    {
      "name": "prompt",
      "schema": {
        "type": "string"
      },
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "text",
      "schema": {
        "type": "string"
      },
      "required": true
    },
    {
      "name": "finish_reason",
      "schema": {
        "type": "string"
      },
      "required": true
    },
    {
      "name": "usage",
      "schema": {
        "type": "object",
        "properties": {
          "inputTokens": {
            "type": "integer",
            "minimum": 0
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["inputTokens", "outputTokens"]
      },
      "required": true
    }
  ],
  "controlPorts": [],
  "portRules": [],
  "credentials": [
    {
      "name": "llm",
      "types": ["openai.api_key", "anthropic.api_key", "ollama.none"],
      "required": true
    }
  ],
  "capabilities": ["generation", "credentials", "streaming"],
  "idempotency": "safe",
  "pool": "general",
  "generation": true,
  "streams": true,
  "optionProviders": ["models"],
  "migrations": [],
  "defaultPolicy": {
    "timeoutMs": 120000
  }
}
