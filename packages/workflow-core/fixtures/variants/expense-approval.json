{
  "$schema": "https://flowaid.dev/schemas/workflow/v1",
  "id": "7f3c1a2e-5b4d-4c8e-9a61-2d0e8b7c4f15",
  "name": "Expense approval",
  "description": "Checks an expense claim against the spending policy, approves small compliant claims automatically and sends the rest to a manager to approve. The approval limits are settings you can change.",
  "inputs": {
    "type": "object",
    "required": ["employee", "amount", "merchant", "description", "has_receipt"],
    "properties": {
      "employee": {
        "type": "string",
        "title": "Employee",
        "description": "Who is claiming. For example: Dana Lee.",
        "minLength": 1
      },
      "amount": {
        "type": "number",
        "title": "Amount (USD)",
        "description": "The amount claimed, in US dollars. For example: 42.50.",
        "minimum": 0
      },
      "merchant": {
        "type": "string",
        "title": "Merchant",
        "description": "Where the money was spent. For example: Delta Air Lines.",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "title": "Business purpose",
        "description": "What it was for. For example: Taxi from the airport to the customer's office.",
        "minLength": 1,
        "maxLength": 2000
      },
      "has_receipt": {
        "type": "boolean",
        "title": "Receipt attached",
        "description": "Whether the employee attached a receipt.",
        "default": true
      }
    }
  },
  "outputs": {
    "type": "object",
    "required": ["status", "category", "amount", "decided_by"],
    "properties": {
      "status": {
        "type": "string",
        "enum": ["approved", "rejected", "expired"]
      },
      "category": {
        "type": "string"
      },
      "amount": {
        "type": "number"
      },
      "decided_by": {
        "type": "string",
        "enum": ["policy", "manager"]
      }
    }
  },
  "secrets": [
    {
      "name": "TYPESAFE_API_KEY",
      "credentialType": "typesafe.api_key",
      "required": false,
      "description": "Optional: without a credential bound here, runs use the TYPESAFE_API_KEY set on the server."
    }
  ],
  "variables": [
    {
      "name": "autoApproveLimit",
      "schema": {
        "type": "number",
        "minimum": 0
      },
      "default": 75,
      "description": "Claims at or under this amount (USD) are approved without a manager when they are within policy and low risk."
    },
    {
      "name": "receiptRequiredOver",
      "schema": {
        "type": "number",
        "minimum": 0
      },
      "default": 25,
      "description": "Claims over this amount (USD) need a receipt to be approved automatically."
    }
  ],
  "execution": {
    "timeoutMs": 345600000,
    "maxCostUsd": 0.05,
    "decisions": {
      "primary": {
        "provider": "typesafe",
        "model": "jev-latest"
      }
    }
  },
  "nodes": [
    {
      "id": "start",
      "kind": "input",
      "name": "Expense claim"
    },
    {
      "id": "review",
      "kind": "task",
      "type": "flowaid.decision.batch",
      "typeVersion": "1.0.0",
      "name": "Check against policy",
      "description": "One TypeSafe call: which category, whether it is within policy, and how risky it looks.",
      "config": {
        "questions": {
          "category": {
            "kind": "choice",
            "instructions": "Which spending category is this expense?",
            "options": {
              "travel": "Flights, hotels, taxis, trains, mileage",
              "meals": "Meals and client entertainment",
              "software": "Software, subscriptions and online services",
              "office": "Office supplies and equipment",
              "training": "Courses, books and conferences",
              "other": "Anything else"
            }
          },
          "within_policy": {
            "kind": "boolean",
            "instructions": "Spending policy: the business purpose must be clear; no alcohol, personal items, gifts over $50, first-class or business-class travel, or fines. Is this expense within policy?",
            "criteria": {
              "true": "Within policy",
              "false": "Breaks the policy or the purpose is unclear"
            }
          },
          "risk": {
            "kind": "score",
            "instructions": "How likely is this claim to be personal, duplicated or inflated?",
            "levels": ["None", "Low", "Moderate", "High", "Very high"]
          }
        }
      },
      "inputs": {
        "state": {
          "kind": "object",
          "fields": {
            "employee": {
              "kind": "ref",
              "ref": {
                "kind": "port",
                "node": "start",
                "port": "employee"
              }
            },
            "amount": {
              "kind": "ref",
              "ref": {
                "kind": "port",
                "node": "start",
                "port": "amount"
              }
            },
            "merchant": {
              "kind": "ref",
              "ref": {
                "kind": "port",
                "node": "start",
                "port": "merchant"
              }
            },
            "description": {
              "kind": "ref",
              "ref": {
                "kind": "port",
                "node": "start",
                "port": "description"
              }
            },
            "has_receipt": {
              "kind": "ref",
              "ref": {
                "kind": "port",
                "node": "start",
                "port": "has_receipt"
              }
            }
          }
        }
      },
      "credentials": {
        "typesafe": "TYPESAFE_API_KEY"
      }
    },
    {
      "id": "limits",
      "kind": "task",
      "type": "flowaid.data.transform",
      "typeVersion": "1.0.0",
      "name": "Apply the limits",
      "description": "Compares the claim with the approval limits in this workflow's settings.",
      "config": {
        "expr": "{ auto: review.answers.within_policy.value && review.answers.risk.value < 1.5 && start.amount <= $vars.autoApproveLimit && (start.has_receipt || start.amount <= $vars.receiptRequiredOver) }",
        "output": {
          "type": "object",
          "required": ["auto"],
          "properties": {
            "auto": {
              "type": "boolean"
            }
          }
        }
      },
      "inputs": {},
      "credentials": {}
    },
    {
      "id": "route",
      "kind": "branch",
      "name": "Approve automatically?",
      "cases": [
        {
          "port": "auto",
          "when": "limits.result.auto"
        }
      ],
      "defaultPort": "manager"
    },
    {
      "id": "manager",
      "kind": "human",
      "name": "Manager approval",
      "mode": {
        "type": "approval"
      },
      "title": {
        "kind": "template",
        "source": "Approve {{ start.employee }}'s {{ review.answers.category.value }} expense of ${{ start.amount }} at {{ start.merchant }}?"
      },
      "context": {
        "purpose": {
          "kind": "ref",
          "ref": {
            "kind": "port",
            "node": "start",
            "port": "description"
          }
        },
        "receipt": {
          "kind": "ref",
          "ref": {
            "kind": "port",
            "node": "start",
            "port": "has_receipt"
          }
        },
        "policy_check": {
          "kind": "ref",
          "ref": {
            "kind": "port",
            "node": "review",
            "port": "answers"
          }
        }
      },
      "expiresInMs": 259200000,
      "onExpire": "route"
    },
    {
      "id": "out_auto",
      "kind": "output",
      "name": "Approved by policy",
      "outcome": "approved",
      "value": {
        "kind": "object",
        "fields": {
          "status": {
            "kind": "literal",
            "value": "approved"
          },
          "category": {
            "kind": "ref",
            "ref": {
              "kind": "port",
              "node": "review",
              "port": "answers",
              "path": "/category/value"
            }
          },
          "amount": {
            "kind": "ref",
            "ref": {
              "kind": "port",
              "node": "start",
              "port": "amount"
            }
          },
          "decided_by": {
            "kind": "literal",
            "value": "policy"
          }
        }
      }
    },
    {
      "id": "out_approved",
      "kind": "output",
      "name": "Approved by manager",
      "outcome": "approved",
      "value": {
        "kind": "object",
        "fields": {
          "status": {
            "kind": "literal",
            "value": "approved"
          },
          "category": {
            "kind": "ref",
            "ref": {
              "kind": "port",
              "node": "review",
              "port": "answers",
              "path": "/category/value"
            }
          },
          "amount": {
            "kind": "ref",
            "ref": {
              "kind": "port",
              "node": "start",
              "port": "amount"
            }
          },
          "decided_by": {
            "kind": "literal",
            "value": "manager"
          }
        }
      }
    },
    {
      "id": "out_rejected",
      "kind": "output",
      "name": "Rejected",
      "outcome": "rejected",
      "value": {
        "kind": "object",
        "fields": {
          "status": {
            "kind": "literal",
            "value": "rejected"
          },
          "category": {
            "kind": "ref",
            "ref": {
              "kind": "port",
              "node": "review",
              "port": "answers",
              "path": "/category/value"
            }
          },
          "amount": {
            "kind": "ref",
            "ref": {
              "kind": "port",
              "node": "start",
              "port": "amount"
            }
          },
          "decided_by": {
            "kind": "literal",
            "value": "manager"
          }
        }
      }
    },
    {
      "id": "out_expired",
      "kind": "output",
      "name": "Not answered in 3 days",
      "outcome": "expired",
      "value": {
        "kind": "object",
        "fields": {
          "status": {
            "kind": "literal",
            "value": "expired"
          },
          "category": {
            "kind": "ref",
            "ref": {
              "kind": "port",
              "node": "review",
              "port": "answers",
              "path": "/category/value"
            }
          },
          "amount": {
            "kind": "ref",
            "ref": {
              "kind": "port",
              "node": "start",
              "port": "amount"
            }
          },
          "decided_by": {
            "kind": "literal",
            "value": "manager"
          }
        }
      }
    },
    {
      "id": "howto",
      "kind": "note",
      "name": "How to make it yours",
      "text": "Change the limits in the workflow panel (click the empty canvas): autoApproveLimit and receiptRequiredOver. Edit the policy wording in \"Check against policy\". Who approves is set on \"Manager approval\" (assignees)."
    }
  ],
  "edges": [
    {
      "id": "c_auto",
      "from": {
        "node": "route",
        "port": "auto"
      },
      "to": {
        "node": "out_auto"
      }
    },
    {
      "id": "c_manager",
      "from": {
        "node": "route",
        "port": "manager"
      },
      "to": {
        "node": "manager"
      }
    },
    {
      "id": "c_ok",
      "from": {
        "node": "manager",
        "port": "approved"
      },
      "to": {
        "node": "out_approved"
      }
    },
    {
      "id": "c_no",
      "from": {
        "node": "manager",
        "port": "rejected"
      },
      "to": {
        "node": "out_rejected"
      }
    },
    {
      "id": "c_late",
      "from": {
        "node": "manager",
        "port": "expired"
      },
      "to": {
        "node": "out_expired"
      }
    }
  ],
  "layout": {
    "nodes": {
      "start": {
        "x": 0,
        "y": 120
      },
      "review": {
        "x": 280,
        "y": 80
      },
      "limits": {
        "x": 580,
        "y": 100
      },
      "route": {
        "x": 860,
        "y": 110
      },
      "manager": {
        "x": 1160,
        "y": 220
      },
      "out_auto": {
        "x": 1160,
        "y": 0
      },
      "out_approved": {
        "x": 1460,
        "y": 140
      },
      "out_rejected": {
        "x": 1460,
        "y": 260
      },
      "out_expired": {
        "x": 1460,
        "y": 380
      },
      "howto": {
        "x": 0,
        "y": 320
      }
    }
  }
}
