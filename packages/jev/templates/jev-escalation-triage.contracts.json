                      "type": "string"
                    }
                  }
                }
              },
              "required": true,
              "dataClass": "internal",
              "redact": "error"
            }
          },
          "maxTokens": 3000,
          "privacyClass": "internal",
          "latencyClass": "interactive",
          "consistency": "record"
        },
        "routing": {
          "consequenceClass": "low",
          "thresholds": {
            "low": {
              "autoAt": 0.9,
              "improveAt": null,
              "minMargin": 0.2
            }
          },
          "escapeRoutes": {
            "none": "human",
            "other": "human",
            "stop": "auto"
          },
