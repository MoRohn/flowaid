    {
      "key": "ops.alert_runbook",
      "description": "Runbook step for a major alert, with a none escape.",
      "body": {
        "key": "ops.alert_runbook",
        "version": 1,
        "title": "Alert runbook step",
        "purpose": "Chooses the permitted automated route for a major alert. Runbook actions carry a stricter consequence class than ticketing, so with default guardrails and illustrative thresholds they go to a person until thresholds are governed and the outcome is rolled out.",
        "owner": "team:sre",
        "question": {
          "kind": "choice",
          "instructions": "Which runbook step fits the failure the evidence shows? Judge only from the alert, the signals and the recent deploys.",
          "menu": {
            "source": "static",
            "outcomes": {
              "restart_workers": {
                "description": "Workers are crash-looping or a queue is stuck while dependencies are healthy and no deploy happened in the last hour.",
                "consequenceClass": "medium",
                "automatable": true
              },
              "scale_out": {
                "description": "Latency or saturation is beyond the SLO while error rates are normal; demand exceeds capacity.",
                "consequenceClass": "medium",
                "automatable": true
              },
              "open_ticket": {
                "description": "A real defect with no immediate remediation step: it needs normal engineering work, not an intervention now.",
                "consequenceClass": "low",
                "automatable": true
              },
              "none": {
                "description": "No listed step fits the evidence, or the evidence points at a recent deploy or a dependency outside this service.",
                "escape": "none",
                "automatable": false
              }
            }
          }
        },
        "fallbackOutcome": "none",
