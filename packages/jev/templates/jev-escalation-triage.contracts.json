                    },
                    "verified": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "required": true,
              "dataClass": "internal",
              "redact": "error",
              "selection": {
                "maxItems": 1,
                "order": "as_bound"
              }
            },
            "signals": {
              "role": "fact",
              "description": "Observable service signals computed in code from the last 15 minutes (SLO comparisons are exact and done before Jev).",
              "schema": {
                "type": "object",
                "properties": {
                  "error_rate_beyond_slo": {
                    "type": "boolean"
                  },
                  "latency_beyond_slo": {
                    "type": "boolean"
                  },
                  "customer_reports_15m": {
                    "type": "integer"
                  },
                  "open_incidents": {
                    "type": "integer"
                  },
                  "deploy_in_last_hour": {
                    "type": "boolean"
                  },
                  "affected_regions": {
                    "type": "array",
