{
  "name": "@flowaid/insights",
  "version": "0.6.0",
  "private": true,
  "description": "Change detection over run history for flowaid: exact and rank-based tests, Benjamini–Hochberg control, and per-workflow insights with their evidence. Pure and browser-safe; the caller supplies the data.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@flowaid/config": "workspace:*",
    "@types/node": "24.19.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
