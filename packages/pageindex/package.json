{
  "name": "@flowaid/pageindex",
  "version": "0.7.0",
  "private": true,
  "description": "PageIndex document intelligence for flowaid: the typed client of the PageIndex service (protocol v1), evidence retrieval by navigating a document's section tree with a decision provider, and citation checks against the evidence.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "development": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@flowaid/shared": "workspace:*",
    "@flowaid/workflow-core": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@flowaid/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
