{
  "name": "@flowaid/nodes-core",
  "version": "0.1.0",
  "private": true,
  "description": "flowaid's core nodes: typed decisions (boolean, choice, score, batch, confidence gate, router, consensus, validator), generation, HTTP, data, developer, state and safety nodes, the manifest build and the demo templates (ARCHITECTURE.md \u00a73, \u00a76.3).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifestFile.ts",
    "./manifest.json": "./manifest.json",
    "./templates/*": "./templates/*"
  },
  "files": [
    "src",
    "dist",
    "templates",
    "manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "manifest": "tsx scripts/build-manifest.ts",
    "manifest:check": "tsx scripts/build-manifest.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "@flowaid/node-sdk": "workspace:*",
    "@flowaid/providers": "workspace:*",
    "@flowaid/shared": "workspace:*",
    "@flowaid/workflow-core": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@flowaid/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
