{
  "name": "@flowaid/mcp",
  "version": "0.6.0",
  "private": true,
  "description": "MCP client for flowaid: pooled sessions (streamable HTTP, SSE, policy-gated stdio), discovery with sanitisation and injection flags, tool policy, OAuth 2.1 PKCE helpers, and workflows exposed as MCP tools (ARCHITECTURE.md §10.2).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@flowaid/shared": "workspace:*",
    "@flowaid/workflow-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.1"
  },
  "devDependencies": {
    "@flowaid/config": "workspace:*",
    "@types/node": "24.19.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  }
}
