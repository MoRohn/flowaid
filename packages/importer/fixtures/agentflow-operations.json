      "data": {
        "id": "httpAgentflow_0",
        "name": "httpAgentflow",
        "label": "Fetch ticket",
        "inputs": {
          "method": "GET",
          "url": "https://api.example.com/tickets/{{ $form.ticketId }}",
          "headers": [
            { "key": "Authorization", "value": "Bearer sk-live-should-never-be-imported" },
            { "key": "Accept", "value": "application/json" }
          ],
          "responseType": "json"
        }
      }
    },
    {
      "id": "conditionAgentflow_0",
      "type": "agentFlow",
      "position": { "x": 520, "y": 0 },
      "data": {
        "id": "conditionAgentflow_0",
        "name": "conditionAgentflow",
        "label": "Urgent?",
        "inputs": {
          "conditions": [
            {
              "type": "number",
              "value1": "{{ $form.priority }}",
              "operation": "larger",
              "value2": "3"
            }
          ]
        }
      }
    },
    {
      "id": "customFunctionAgentflow_0",
      "type": "agentFlow",
      "position": { "x": 780, "y": -120 },
