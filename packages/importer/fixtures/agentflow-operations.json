        "id": "llmAgentflow_1",
        "name": "llmAgentflow",
        "label": "Summarise line",
        "inputs": {
          "llmModel": "chatGoogleGenerativeAI",
          "llmModelConfig": { "modelName": "gemini-2.0-flash" },
