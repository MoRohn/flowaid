        "inputs": {
          "customFunctionInputVariables": [
            { "variableName": "ticket", "variableValue": "{{ httpAgentflow_0 }}" }
          ],
          "customFunctionJavascriptFunction": "return ($ticket.lines ?? []).map((l) => l.text);"
        }
      }
    },
    {
