{
  "name": "@flowaid/plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin discovery, resolution and installation (ARCHITECTURE.md \u00a73.5): the npm registry client (packuments, search), the allow-list, semver ranges, tarball integrity (SRI) and safe tgz extraction. Never loads plugin code.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "development": "./src/testing.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@flowaid/shared": "workspace:*",
    "@flowaid/workflow-core": "workspace:*"
  },
  "devDependencies": {
    "@flowaid/config": "workspace:*",
    "@types/node": "26.6.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
