{
  "name": "@flowaid/create-flowaid-node",
  "version": "0.9.1",
  "private": true,
  "description": "Scaffold a publishable FlowAId node package: `npm create flowaid-node @acme/nodes-crm` (defineNode example, harness test, manifest check, flowaid-node keyword and the flowaid package.json field).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "create-flowaid-node": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo .scaffold-test *.tsbuildinfo"
  },
  "dependencies": {
    "@flowaid/node-sdk": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@flowaid/config": "workspace:*",
    "@flowaid/plugins": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
