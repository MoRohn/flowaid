exports[`generated CLI > matches the root help snapshot 1`] = `
"Usage: flowaid [options] [command]

FlowAId command line: every API operation, plus local runs and the dev stack

Options:
  -V, --cli-version                 print the CLI version
  --api-url <url>                   API origin (env FLOWAID_API_URL; default http://localhost:3000)
  --api-key <key>                   API key (env FLOWAID_API_KEY, or the key saved by login)
  --workspace <slug>                workspace slug or id (env FLOWAID_WORKSPACE)
  -o, --output <format>             json | yaml
  --json                            print JSON
  -h, --help                        display help for command

Commands:
  login                             save an API key (from --api-key, FLOWAID_API_KEY or stdin) for
                                    --api-url after checking it
  logout                            forget the saved API key
  dev [options]                     start the local stack (docker compose) and open the web app
  validate [options] <path>         compile a workflow definition locally (bundled core nodes) and
                                    list diagnostics
  api-key|api-keys                  api-key operations
  artifact|artifacts                artifact operations
  audit|audits                      audit operations
  auth|auths                        auth operations
  credential-type|credential-types  credential-type operations
  credential|credentials            credential operations
  dataset|datasets                  dataset operations
  deployment|deployments            deployment operations
  environment|environments          environment operations
  evaluation|evaluations            evaluation operations
  event|events                      event operations
  job|jobs                          job operations
  mcp-exposure|mcp-exposures        mcp-exposure operations
  mcp-server|mcp-servers            mcp-server operations
  mcp-token|mcp-tokens              mcp-token operations
  me|mes                            me operations
  member|members                    member operations
  model|models                      model operations
  node|nodes                        node operations
  provider|providers                provider operations
  review|reviews                    review operations
  run|runs                          run operations
  schedule|schedules                schedule operations
  secret|secrets                    secret operations
  system|systems                    system operations
  task|tasks                        task operations
  template|templates                template operations
  tool|tools                        tool operations
  version|versions                  version operations
  webhook|webhooks                  webhook operations
  workflow|workflows                workflow operations
  workspace|workspaces              workspace operations
  help [command]                    display help for command
"
`;
