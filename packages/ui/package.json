{
  "name": "@flowaid/ui",
  "version": "0.1.0",
  "private": true,
  "description": "FlowAId React component library: primitives, decision visualizations, canvas nodes, trace viewer, inspector and forms.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./primitives": "./src/primitives/index.ts",
    "./decision": "./src/decision/index.ts",
    "./node": "./src/node/index.ts",
    "./canvas": "./src/canvas/index.ts",
    "./trace": "./src/trace/index.ts",
    "./inspector": "./src/inspector/index.ts",
    "./forms": "./src/forms/index.ts",
    "./shell": "./src/shell/index.ts",
    "./data": "./src/data/index.ts",
    "./observability": "./src/observability/index.ts",
    "./human": "./src/human/index.ts",
    "./builder": "./src/builder/index.ts",
    "./theme": "./src/theme/index.ts",
    "./lib": "./src/lib/index.ts"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "build:playground": "vite build --config playground/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src playground",
    "test": "vitest run",
    "clean": "rm -rf dist playground/dist .turbo",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@flowaid/workflow-core": "workspace:*",
    "@lezer/highlight": "1.2.3",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "@xyflow/react": "12.11.6",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "croner": "10.0.1",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "date-fns": "4.4.0",
    "lucide-react": "1.47.0",
    "motion": "13.4.1",
    "react-hook-form": "7.88.0",
    "react-resizable-panels": "4.13.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@flowaid/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
